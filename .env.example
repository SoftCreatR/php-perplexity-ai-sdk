# Project API key used by ordinary examples.
PERPLEXITY_API_KEY=

# Legacy project API key name retained for compatibility.
PERPLEXITYAI_API_KEY=

# Organization analytics key used only by examples/analytics.
PERPLEXITY_ANALYTICS_API_KEY=

# Optional compatible endpoint overrides. The defaults are api.perplexity.ai and /v1.
PERPLEXITY_API_ORIGIN=
PERPLEXITY_API_BASE_PATH=

# Common resources used by examples
PERPLEXITY_AGENT_RESPONSE_ID=
PERPLEXITY_AGENT_FILE_ID=
PERPLEXITY_ASYNC_REQUEST_ID=
PERPLEXITY_AUTH_TOKEN=
PERPLEXITY_ROUTER_MODEL=openai/gpt-5-mini
